# Antidote
_antidote_paths=()
[[ -n "${ANTIDOTE_HOME:-}" ]] && _antidote_paths+=("$ANTIDOTE_HOME/antidote.zsh")
[[ -n "${XDG_DATA_HOME:-}" ]] && _antidote_paths+=("$XDG_DATA_HOME/antidote/antidote.zsh")
_antidote_paths+=("$HOME/.local/share/antidote/antidote.zsh")

if [[ -n "${HOMEBREW_PREFIX:-}" ]]; then
    _antidote_paths+=("$HOMEBREW_PREFIX/opt/antidote/share/antidote/antidote.zsh")
fi

if command -v brew >/dev/null 2>&1; then
    _antidote_prefix="$(brew --prefix antidote 2>/dev/null)"
    [[ -n "$_antidote_prefix" ]] && _antidote_paths+=("$_antidote_prefix/share/antidote/antidote.zsh")
    unset _antidote_prefix
fi

for _antidote_file in "${_antidote_paths[@]}"; do
    if [[ -r "$_antidote_file" ]]; then
        source "$_antidote_file"
        break
    fi
done
unset _antidote_file _antidote_paths

if command -v antidote >/dev/null 2>&1; then
    antidote load ${ZDOTDIR:-$HOME}/.zsh_plugins.txt
else
    print -u2 "[WARN] Antidote not found; skipping zsh plugins."
fi

# Aliases
alias rm='rm -i'
alias mv='mv -i'
alias cp='cp -i'
alias vim='nvim'
alias vi='nvim'

# Plugins
if command -v fzf >/dev/null 2>&1; then
    if fzf --zsh >/dev/null 2>&1; then
        source <(fzf --zsh)
    else
        _fzf_paths=()
        [[ -n "${FZF_BASE:-}" ]] && _fzf_paths+=("$FZF_BASE")
        [[ -n "${HOMEBREW_PREFIX:-}" ]] && _fzf_paths+=("$HOMEBREW_PREFIX/opt/fzf")

        if command -v brew >/dev/null 2>&1; then
            _fzf_prefix="$(brew --prefix fzf 2>/dev/null)"
            [[ -n "$_fzf_prefix" ]] && _fzf_paths+=("$_fzf_prefix")
            unset _fzf_prefix
        fi

        for _fzf_dir in "${_fzf_paths[@]}"; do
            [[ -r "$_fzf_dir/shell/key-bindings.zsh" ]] && source "$_fzf_dir/shell/key-bindings.zsh"
            [[ -r "$_fzf_dir/shell/completion.zsh" ]] && source "$_fzf_dir/shell/completion.zsh"
        done

        if command -v dpkg-query >/dev/null 2>&1; then
            for _fzf_file in ${(f)"$(dpkg-query -L fzf 2>/dev/null)"}; do
                case "$_fzf_file" in
                    */key-bindings.zsh) [[ -r "$_fzf_file" ]] && source "$_fzf_file" ;;
                    */completion.zsh) [[ -r "$_fzf_file" ]] && source "$_fzf_file" ;;
                esac
            done
        fi

        unset _fzf_dir _fzf_file _fzf_paths
    fi
fi

# PATH
export PATH="$HOME/.local/bin:$PATH"
