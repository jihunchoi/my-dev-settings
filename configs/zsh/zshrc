# Make user-installed tools available to modules and fzf initialization.
export PATH="$HOME/.local/bin:$PATH"

# Use Keeper's local macOS SSH agent when its socket is available.
# Preserve the forwarded agent when this Mac is reached over SSH.
if [[ "$OSTYPE" == darwin* && -z "${SSH_CONNECTION:-}" && -z "${SSH_CLIENT:-}" ]]; then
    if [[ -S "$HOME/Library/Containers/com.callpod.keepermac.lite/Data/tmp/keeper-ssh-agent.sock" ]]; then
        export SSH_AUTH_SOCK="$HOME/Library/Containers/com.callpod.keepermac.lite/Data/tmp/keeper-ssh-agent.sock"
    fi
fi

# Keep the existing Oh My Zsh history file when migrating to Zim.
HISTFILE="${HISTFILE:-$HOME/.zsh_history}"
bindkey -e

# Zim: setup installs the manager and generates init.zsh ahead of time.
ZIM_HOME="${ZIM_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/zim}"
ZIM_CONFIG_FILE="${ZIM_CONFIG_FILE:-${ZDOTDIR:-$HOME}/.zimrc}"
if [[ -r "$ZIM_HOME/zimfw.zsh" ]]; then
    if [[ ! "$ZIM_HOME/init.zsh" -nt "$ZIM_CONFIG_FILE" ]]; then
        source "$ZIM_HOME/zimfw.zsh" init
    fi
    [[ -r "$ZIM_HOME/init.zsh" ]] && source "$ZIM_HOME/init.zsh"
else
    print -u2 "[WARN] Zim not found; run setup_macos.sh or setup_linux.sh to install it."
fi

# Preserve history capacity, timestamps, directory-stack direction, and file
# redirection behavior from the previous configuration.
(( HISTSIZE < 50000 )) && HISTSIZE=50000
(( SAVEHIST < 10000 )) && SAVEHIST=10000
setopt EXTENDED_HISTORY HIST_EXPIRE_DUPS_FIRST PUSHD_MINUS CLOBBER

# Use Zim's recommended word boundaries: stop at path separators.
WORDCHARS=${WORDCHARS//[\/]}

# Aliases
alias rm='rm -i'
alias mv='mv -i'
alias cp='cp -i'
alias vim='nvim'
alias vi='nvim'

# Plugins
if command -v fzf >/dev/null 2>&1; then
    if _fzf_init="$(fzf --zsh 2>/dev/null)"; then
        source <(print -r -- "$_fzf_init")
    else
        _fzf_paths=()
        [[ -n "${FZF_BASE:-}" ]] && _fzf_paths+=("$FZF_BASE")
        [[ -n "${HOMEBREW_PREFIX:-}" ]] && _fzf_paths+=("$HOMEBREW_PREFIX/opt/fzf")

        if command -v brew >/dev/null 2>&1; then
            _fzf_prefix="$(brew --prefix fzf 2>/dev/null)"
            [[ -n "$_fzf_prefix" ]] && _fzf_paths+=("$_fzf_prefix")
            unset _fzf_prefix
        fi

        for _fzf_dir in "${_fzf_paths[@]}"; do
            [[ -r "$_fzf_dir/shell/key-bindings.zsh" ]] && source "$_fzf_dir/shell/key-bindings.zsh"
            [[ -r "$_fzf_dir/shell/completion.zsh" ]] && source "$_fzf_dir/shell/completion.zsh"
        done

        if command -v dpkg-query >/dev/null 2>&1; then
            for _fzf_file in ${(f)"$(dpkg-query -L fzf 2>/dev/null)"}; do
                case "$_fzf_file" in
                    */key-bindings.zsh) [[ -r "$_fzf_file" ]] && source "$_fzf_file" ;;
                    */completion.zsh) [[ -r "$_fzf_file" ]] && source "$_fzf_file" ;;
                esac
            done
        fi

        unset _fzf_dir _fzf_file _fzf_paths
    fi
    unset _fzf_init
fi
